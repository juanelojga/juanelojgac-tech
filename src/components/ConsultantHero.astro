---
import enTranslations from "../i18n/en.json";
import esTranslations from "../i18n/es.json";
import type { Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).consultant.hero;
---

<section class="bg-tarawera px-4 py-6 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-7xl text-center">
    <h1 class="font-sora text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">
      {t.headline}
    </h1>
    <p class="text-tarawera-lighter mx-auto mt-3 max-w-2xl text-base sm:mt-4 sm:text-lg">
      {t.subheadline}
    </p>
    <a
      href="#consultant"
      class="bg-persian-green hover:bg-persian-green-dark focus-visible:outline-persian-green mt-4 inline-flex min-h-[44px] items-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:mt-6 sm:px-6 sm:py-3 sm:text-base"
    >
      {t.ctaLabel}
    </a>
  </div>
</section>
