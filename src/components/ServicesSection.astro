---
import enTranslations from "../i18n/en.json";
import esTranslations from "../i18n/es.json";
import { StaticContentProvider } from "../lib/chat/content/static-content-provider";
import type { Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).redesign.services;
const contentProvider = new StaticContentProvider();
const services = contentProvider.getServices(lang);
---

<section
  id="services"
  class="border-t border-white/5 bg-[#060e1a] py-16 lg:py-24"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="mb-12 text-center">
      <h2
        id="services-heading"
        class="font-sora text-text-bright text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl"
      >
        {t.sectionTitle}
      </h2>
      <p class="text-text-muted mx-auto mt-4 max-w-2xl text-lg">
        {t.sectionSubtitle}
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="rounded-2xl border border-white/5 bg-white/2 p-6 transition-colors duration-200 hover:border-white/10 hover:bg-white/4 lg:p-8">
            <h3 class="font-sora text-text-bright text-lg font-semibold lg:text-xl">
              {service.title}
            </h3>
            <p class="text-text-muted mt-3 text-sm leading-relaxed lg:text-base">
              {service.description}
            </p>
            <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold">
              <span class="text-accent-cyan rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1">
                {t.priceLabel} {service.pricingRange.description} USD
              </span>
              <span class="text-text-bright rounded-full border border-white/10 bg-white/3 px-3 py-1">
                {t.timelineLabel} {service.deliveryTimeline.description}
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
