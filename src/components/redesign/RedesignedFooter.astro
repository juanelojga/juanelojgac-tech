---
import enTranslations from "../../i18n/en.json";
import esTranslations from "../../i18n/es.json";
import type { Language } from "../../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).redesign.footer;
const homeUrl = lang === "en" ? "/" : "/es";

const navLinks = [
  { label: t.navServices, href: "#services" },
  { label: t.navProcess, href: "#process" },
  { label: t.navAbout, href: "#about" },
  { label: t.navContact, href: "#contact" },
  { label: t.navPrivacy, href: "/privacy" },
];

const trustNotes = [t.trustBilingual, t.trustDelivery, t.trustCode, t.trustMarkets];

const socialLinks = [
  {
    label: "GitHub",
    href: "https://github.com/juanelojga",
    icon: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/juanelojga",
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    label: "Instagram",
    href: "https://instagram.com/juanelojgac",
    icon: `<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>`,
  },
];
---

<footer class="border-t border-white/5 bg-[#050d18] pt-16 pb-8 lg:pt-24">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <!-- 4-column grid -->
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Col 1: Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={homeUrl} class="mb-4 inline-block">
          <img
            src="/assets/logo/logo.png"
            alt="JuaneloJGAC Tech"
            class="h-10 w-auto"
            loading="lazy"
            width="40"
            height="40"
          />
        </a>
        <p class="text-text-bright mb-2 text-sm font-semibold">
          {t.brandStatement}
        </p>
        <p class="text-text-muted text-sm leading-relaxed">
          {t.brandParagraph}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-text-bright mb-4 text-xs font-semibold tracking-wider uppercase">
          {t.navLabel}
        </h3>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-muted hover:text-text-bright text-sm transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Trust Notes -->
      <div>
        <h3 class="text-text-bright mb-4 text-xs font-semibold tracking-wider uppercase">
          {t.trustLabel}
        </h3>
        <ul class="space-y-3">
          {
            trustNotes.map((note) => (
              <li class="text-text-muted flex items-start gap-2 text-sm">
                <span class="text-accent-cyan mt-0.5 shrink-0" aria-hidden="true">
                  ✓
                </span>
                {note}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Social -->
      <div>
        <h3 class="text-text-bright mb-4 text-xs font-semibold tracking-wider uppercase">
          {t.socialLabel}
        </h3>
        <div class="flex items-center gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="social-icon-link text-text-muted hover:text-accent-cyan rounded-lg p-2 transition-all duration-200"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <Fragment set:html={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom bar: copyright -->
    <div class="mt-12 border-t border-white/5 pt-6 text-center">
      <p class="text-text-muted text-sm">{t.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .social-icon-link:hover {
    filter: drop-shadow(0 0 6px var(--color-accent-cyan));
  }
</style>
