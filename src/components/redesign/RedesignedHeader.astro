---
import enTranslations from "../../i18n/en.json";
import esTranslations from "../../i18n/es.json";
import type { Language } from "../../lib/i18n";
import MobileMenu from "./react/MobileMenu";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).redesign.header;
const homeUrl = lang === "en" ? "/" : "/es";
const altLangUrl = lang === "en" ? "/es" : "/";

const navLinks = [
  { label: t.navServices, href: "#services", action: "services" },
  { label: t.navAbout, href: "#about", action: "about" },
  { label: t.navContact, href: "#contact", action: "contact" },
];
---

<header
  class="fixed top-0 right-0 left-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-300 motion-reduce:transition-none"
  id="redesigned-header"
  data-scrolled="false"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 lg:h-20 lg:px-8">
    <!-- Logo -->
    <a href={homeUrl} class="flex shrink-0 items-center">
      <img
        src="/assets/logo/logo.png"
        alt={t.logoAlt}
        class="h-12 w-auto lg:h-14"
        loading="eager"
        width="56"
        height="56"
      />
    </a>

    <!-- Center: Nav links (desktop only) -->
    <nav class="hidden lg:flex lg:items-center lg:gap-8" aria-label={t.navServices}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-action={link.action}
            class="text-text-muted hover:text-text-bright text-sm font-medium transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right: Social + Language + CTA (desktop) / Hamburger (mobile) -->
    <div class="flex items-center gap-3 lg:gap-4">
      <!-- Social icons (desktop only) -->
      <div class="hidden items-center gap-2 lg:flex" aria-label="Social">
        <a
          href="https://github.com/juanelojga"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.socialGithubLabel}
          class="text-text-muted hover:text-accent-cyan rounded-lg p-2 transition-colors duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/juanelojga"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.socialLinkedinLabel}
          class="text-text-muted hover:text-accent-cyan rounded-lg p-2 transition-colors duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a
          href="https://instagram.com/juanelojgac"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.socialInstagramLabel}
          class="text-text-muted hover:text-accent-cyan rounded-lg p-2 transition-colors duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>

      <!-- Language switcher (pill style) -->
      <nav
        aria-label={t.languageSwitchLabel}
        class="flex items-center rounded-full border border-white/10 bg-white/5 p-0.5"
      >
        <a
          href={homeUrl}
          aria-current={lang === "en" ? "page" : undefined}
          class:list={[
            "rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-200",
            lang === "en"
              ? "bg-accent-cyan/20 text-accent-cyan"
              : "text-text-muted hover:text-text-bright",
          ]}
        >
          EN
        </a>
        <a
          href={altLangUrl}
          aria-current={lang === "es" ? "page" : undefined}
          class:list={[
            "rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-200",
            lang === "es"
              ? "bg-accent-cyan/20 text-accent-cyan"
              : "text-text-muted hover:text-text-bright",
          ]}
        >
          ES
        </a>
      </nav>

      <!-- CTA button (desktop only) -->
      <a
        href="https://calendly.com/juanelojga/one-on-one-meeting"
        target="_blank"
        rel="noopener noreferrer"
        class="from-accent-cyan to-accent-teal text-midnight hidden rounded-lg bg-gradient-to-r px-5 py-2.5 text-sm font-semibold transition-opacity duration-200 hover:opacity-90 lg:inline-flex"
      >
        {t.ctaLabel}
      </a>

      <!-- Hamburger button (mobile only) -->
      <MobileMenu
        client:load
        lang={lang}
        navLinks={navLinks}
        ctaLabel={t.ctaLabel}
        menuLabel={t.menuLabel}
        closeMenuLabel={t.closeMenuLabel}
        socialGithubLabel={t.socialGithubLabel}
        socialLinkedinLabel={t.socialLinkedinLabel}
        socialInstagramLabel={t.socialInstagramLabel}
        languageSwitchLabel={t.languageSwitchLabel}
        homeUrl={homeUrl}
        altLangUrl={altLangUrl}
        currentLang={lang}
      />
    </div>
  </div>
</header>

<!-- Scroll detection: toggle header background when hero leaves viewport -->
<script>
  function initHeaderScroll() {
    const header = document.getElementById("redesigned-header");
    const hero = document.getElementById("hero-section");
    if (!header) return;

    if (!hero) {
      // No hero on page — always show solid header
      header.setAttribute("data-scrolled", "true");
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        const scrolled = !entry.isIntersecting;
        header.setAttribute("data-scrolled", String(scrolled));
      },
      { threshold: 0, rootMargin: "-80px 0px 0px 0px" }
    );

    observer.observe(hero);
  }

  // Run on initial load and on Astro page transitions
  initHeaderScroll();
  document.addEventListener("astro:after-swap", initHeaderScroll);

  // Intercept nav link clicks to scroll to chat and dispatch action event
  function initNavActions() {
    const header = document.getElementById("redesigned-header");
    if (!header) return;
    header.querySelectorAll<HTMLAnchorElement>("a[data-action]").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const action = link.dataset.action;
        const target = document.getElementById("consultant");
        if (target) target.scrollIntoView({ behavior: "smooth" });
        if (action) {
          window.dispatchEvent(new CustomEvent("consultant:action", { detail: { action } }));
        }
      });
    });
  }
  initNavActions();
  document.addEventListener("astro:after-swap", initNavActions);
</script>

<style>
  #redesigned-header[data-scrolled="true"] {
    background-color: rgba(7, 17, 31, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(56, 189, 248, 0.1);
  }

  #redesigned-header[data-scrolled="false"] {
    background-color: rgba(7, 17, 31, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
  }
</style>
