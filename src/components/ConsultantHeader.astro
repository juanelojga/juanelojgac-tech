---
import enTranslations from "../i18n/en.json";
import esTranslations from "../i18n/es.json";
import type { Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).consultant.header;
const homeUrl = lang === "en" ? "/" : "/es";
---

<header class="border-tarawera-lighter/40 sticky top-0 z-40 border-b bg-white/95 backdrop-blur-sm">
  <div
    class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-16 lg:px-8"
  >
    <!-- Logo -->
    <a href={homeUrl} class="flex shrink-0 items-center gap-2">
      <img
        src="/assets/logo/logo.png"
        alt={t.logoAlt}
        class="h-8 w-auto lg:h-10"
        loading="eager"
        width="40"
        height="40"
      />
    </a>

    <!-- Language Switch -->
    <nav aria-label={t.languageSwitchLabel} class="flex items-center gap-1">
      <a
        href={homeUrl}
        aria-current={lang === "en" ? "page" : undefined}
        class:list={[
          "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
          lang === "en" ? "bg-tarawera text-white" : "text-tarawera hover:bg-tarawera-lightest",
        ]}
      >
        EN
      </a>
      <a
        href={lang === "en" ? "/es" : "/"}
        aria-current={lang === "es" ? "page" : undefined}
        class:list={[
          "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
          lang === "es" ? "bg-tarawera text-white" : "text-tarawera hover:bg-tarawera-lightest",
        ]}
      >
        ES
      </a>
    </nav>
  </div>
</header>
