---
import enTranslations from "../i18n/en.json";
import esTranslations from "../i18n/es.json";
import type { Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).redesign.faq;
---

<section
  id="faq"
  class="border-t border-white/5 bg-[#050d18] py-16 lg:py-24"
  aria-labelledby="faq-heading"
>
  <div class="mx-auto max-w-3xl px-4 lg:px-8">
    <h2
      id="faq-heading"
      class="font-sora text-text-bright mb-12 text-center text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl"
    >
      {t.sectionTitle}
    </h2>

    <div class="space-y-6">
      {
        t.items.map((item) => (
          <details class="group rounded-xl border border-white/5 bg-white/[0.02] transition-colors duration-200 open:border-white/10 open:bg-white/[0.04]">
            <summary class="text-text-bright flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold select-none lg:text-lg">
              <span>{item.question}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-text-muted shrink-0 transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="text-text-muted px-6 pt-0 pb-5 text-sm leading-relaxed lg:text-base">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
