---
import enTranslations from "../i18n/en.json";
import esTranslations from "../i18n/es.json";
import type { Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = (lang === "es" ? esTranslations : enTranslations).consultant.footer;
---

<footer class="border-neutral-lighter border-t bg-white px-4 py-6 sm:px-6 lg:px-8">
  <div
    class="text-neutral mx-auto flex max-w-7xl flex-col items-center gap-3 text-sm sm:flex-row sm:justify-between"
  >
    <p>{t.copyright}</p>
    <nav class="flex items-center gap-4">
      <a
        href="mailto:hello@juanelojgac.tech"
        class="text-tarawera hover:text-persian-green inline-flex min-h-[44px] items-center transition-colors sm:min-h-0"
      >
        {t.contactLabel}
      </a>
      <span class="text-neutral-lighter" aria-hidden="true">·</span>
      <a
        href="/privacy"
        class="text-tarawera hover:text-persian-green inline-flex min-h-[44px] items-center transition-colors sm:min-h-0"
      >
        {t.privacyLabel}
      </a>
    </nav>
  </div>
</footer>
