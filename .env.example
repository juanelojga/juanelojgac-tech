# Public runtime vars (safe for client)
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Server-only vars
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Site metadata used by the Netlify chat function / OpenRouter headers
SITE_URL=https://your-domain.com
SITE_TITLE=Your Site Title
OPENROUTER_API_URL=https://your-openrouter-api-url
